# Copy to .env. Never commit .env.
TMDB_API_KEY=
LLM_PROVIDER=gemini        # gemini | groq | cloudflare | ollama
LLM_API_KEY=               # Cloudflare: an API token with Workers AI permission
LLM_MODEL=                 # required, e.g. @cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_ACCOUNT_ID=     # only for LLM_PROVIDER=cloudflare
OLLAMA_URL=http://localhost:11434
SMTP_USER=
SMTP_APP_PASSWORD=
DIGEST_TO=
REGION=KE
DB_PATH=actionpicker.db
